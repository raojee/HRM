# DigiSailHRM Environment Configuration Template
# Copy this file to .env and replace placeholders with your credentials

# Neon Serverless PostgreSQL Connection String (Pooled for Next.js App Router)
DATABASE_URL="postgresql://neondb_owner:your_password_here@ep-your-endpoint-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Neon Direct / Unpooled Connection String (Used for Prisma migrations & db push)
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:your_password_here@ep-your-endpoint.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Neon Branch
NEON_BRANCH=production

# JWT Authentication Secret Key (256-bit secure secret)
JWT_SECRET="your_secure_256_bit_jwt_secret_key_here"
